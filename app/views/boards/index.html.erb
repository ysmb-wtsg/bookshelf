<div class="container pt-3">
  <div class="row">
    <div class="col-lg-12">
      <div class="d-flex justify-content-between align-items-center mb-5">  
        <h2 class="mb-0">書籍一覧</h2>
        <%= link_to '＋ 書籍を登録', new_board_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <div class="row">
        <% if @boards.present? %>
          <%= render @boards %>
        <% else %>
          <div class="mb-3">書籍がありません</div>
        <% end %>
        <%= paginate @boards, theme: 'bootstrap-5' %>
      </div>
    </div>
  </div>
</div>