<div class="container pt-3">
  <div class="row">
    <div class="col-lg-12">
      <div class="d-flex justify-content-between align-items-center mb-4">  
        <h2 class="mb-0">書籍一覧</h2>
        <%= link_to '＋ 書籍を登録', new_board_path, class: "btn btn-primary" %>
      </div>
      <!-- 検索フォーム -->
      <%= render 'search_form', q: @q, url: boards_path %>
    </div>
  </div>
  <!-- バッジ -->
  <div class="mt-4 mb-3">
    <h5><span class="badge text-bg-primary me-1">Ruby</span>
    <span class="badge text-bg-success me-1">設計</span>
    <span class="badge text-bg-warning me-1">小説</span>
    <span class="badge text-bg-info me-1">ビジネス</span>
    <span class="badge text-bg-secondary">自己啓発</span></h5>
  </div>
  <div class="row">
    <div class="col-12">
      <div class="row">
        <% if @boards.present? %>
          <%= render @boards %>
        <% else %>
          <div class="mb-3">書籍がありません</div>
        <% end %>
        <%= paginate @boards, theme: 'bootstrap-5' %>
      </div>
    </div>
  </div>
</div>