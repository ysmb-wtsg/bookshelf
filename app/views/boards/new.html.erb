<div class="container">
  <div class="row">
    <div class="col-lg-12 mt-4">
      <%= link_to '書籍一覧', boards_path, class:"link" %> / 書籍を登録
      <h2 class="mt-3">書籍を登録</h2>
        <div class="card mt-4">
      <%= form_with model: @board, class: "new_board" do |f| %>
        <div class="m-3">
          <%= f.label :title, 'タイトル' %>
          <%= f.text_field :title, class: "form-control mt-2", placeholder: "例: リーダブルコード" %>
        </div>
        <div class="m-3">
          <%= f.label :author, '著者' %>
          <%= f.text_field :author, class: "form-control mt-2", placeholder: "例: Dustin Boswell, Trevor Foucher" %>
          <small class="form-text text-muted">複数名の場合はカンマ区切りで入力</small>
        </div>
        <div class="m-3">
          <%= f.label :body, '説明' %>
          <%= f.text_area :body, class: "form-control mt-2", placeholder: "書籍の概要を入力してください...", rows: "5" %>
        </div>
        <div class="m-3">
          <%= f.label :tag_ids, 'タグ' %>
            <div class="mt-2">
              <%= f.collection_check_boxes(:tag_ids, Tag.all, :id, :name) do |b| %>
                <div class="form-check form-check-inline">
                  <%= b.check_box class: "form-check-input" %>
                  <%= b.label class: "form-check-label" %>
                </div>
              <% end %>
            </div>
        </div>
        <hr>
        <div class="m-3">
          <%= f.submit '✓登録する', class: "btn btn-primary" %>
          <%= link_to 'キャンセル', boards_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
      </div>
    </div>
  </div>
</div>