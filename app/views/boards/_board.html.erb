<div class="col-sm-12 col-lg-4 mb-3">
  <div id="board-id-<%= board.id %>">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <h4 class="card-title">
            <%= link_to board.title, board_path(board), class:"text-dark link board-link fs-5" %>
          </h4>

          <!-- 星の表示 -->
          <div class="star-rating">
            <% if board.reviews.any? %>
                    <% average_rate = board.reviews.average(:rate).to_f %>
                    <% full_stars = average_rate.floor %>
                    <% half_star = (average_rate - full_stars) >= 0.5 %>
                    <% empty_stars = 5 - full_stars - (half_star ? 1 : 0) %>
                    <!-- 塗りつぶされた星 -->
                    <% full_stars.times do %>
                      <i class="bi bi-star-fill text-warning"></i>
                    <% end %>
                    <!-- 半分の星 -->
                    <% if half_star %>
                      <i class="bi bi-star-half text-warning"></i>
                    <% end %>
                    <!-- 空の星 -->
                    <% empty_stars.times do %>
                      <i class="bi bi-star text-warning"></i>
                    <% end %>
                  <% else %>
                    <small class="text-muted">まだレビューがありません</small>
                  <% end %>
                </div>

        </div>
        <ul class="list-inline">
          <li class="list-inline-item fs-6 text-muted"><i class="bi bi-person"></i> <%= board.author %></li>
        </ul>
        <p class="card-text small"><%= truncate(board.body, length: 100) %></p>
        <hr>
        <div class="d-flex justify-content-between align-items-center">
          <small class="text-muted"><i class="bi bi-chat-dots"></i> レビュー <%= board.reviews.count %>件</small>
          <small class="text-muted"><%= board.created_at.strftime("%Y-%m-%d") %> 登録</small>
        </div>
     
      </div>
    </div>
  </div>
</div>