<div class="col-sm-12 col-lg-4 mb-3">
  <div id="board-id-<%= board.id %>">
    <div class="card">
      <%= image_tag "board_placeholder.png", class: "card-img-top", width: "300", height:"200" %>
      <div class="card-body">
        <div class="d-flex">
          <h4 class="card-title">
            <%= link_to board.title, board_path(board) %>
          </h4>
        </div>
        <ul class="list-inline">
          <li class="list-inline-item"><i class="bi bi-person-fill"></i> <%= board.author %></li>
          <li class="list-inline-item"><i class="bi bi-calendar"></i> <%= l board.created_at, format: :short %></li>
        </ul>
        <p class="card-text"><%= truncate(board.body, length: 100) %></p>
        <div class="text-muted small">
          登録者: <%= board.user.name %>
        </div>
      </div>
    </div>
  </div>
</div>