<div class="col-sm-12 col-lg-4 mb-3">
  <div id="board-id-<%= board.id %>">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <h4 class="card-title">
            <%= link_to board.title, board_path(board), class:"text-dark link board-link fs-5" %>
          </h4>

          <!-- 星の表示 -->
          <%= render 'boards/star_rating', board: board %>
        </div>

        <ul class="list-inline">
          <li class="list-inline-item fs-6 text-muted"><i class="bi bi-person"></i> <%= board.author %></li>
        </ul>
        <p class="card-text small"><%= truncate(board.body, length: 100) %></p>

        <% if board.tags.present? %>
          <div class="mb-2">
            <% board.tags.each do |tag| %>
              <% 
                badge_class = case tag.name
                when 'Ruby'
                  'text-bg-primary'
                when '設計'
                  'text-bg-success'
                when '小説'
                  'text-bg-warning'
                when 'ビジネス'
                  'text-bg-info'
                when '自己啓発'
                  'text-bg-secondary'
                else
                  'text-bg-secondary'
                end
              %>
              <span class="badge <%= badge_class %> me-1"><%= tag.name %></span>
            <% end %>
          </div>
        <% end %>

        <hr>
        <div class="d-flex justify-content-between align-items-center">
          <small class="text-muted"><i class="bi bi-chat-dots"></i> レビュー <%= board.reviews.size %>件</small>
          <small class="text-muted"><%= board.created_at.strftime("%Y-%m-%d") %> 登録</small>
        </div>
      </div>
    </div>
  </div>
</div>