<div class="container">
  <div class="row">
    <div class="col-lg-12 mt-4">
      <%= link_to '書籍一覧', boards_path, class:"link" %> / <%= @board.title %>
        <article class="card mt-3">
          <div class="card-body">
            <div class="row">
              <div class="col-md-8">
                <h3><%= @board.title %></h3>
                <div class="text-muted mt-2">
                  <i class="bi bi-person"></i> <%= @board.author %>
                </div>           
                
                <!-- 星の表示 -->
                <div class="mt-3">
                  <%= render 'boards/star_rating', board: @board, show_detail: true %>
                </div>

                <p><%= simple_format(@board.body) %></p>

                <!-- タグの表示 -->
                <% if @board.tags.present? %>
                  <div class="mb-2">
                    <% @board.tags.each do |tag| %>
                      <% 
                        badge_class = case tag.name
                        when 'Ruby'
                          'text-bg-primary'
                        when '設計'
                          'text-bg-success'
                        when '小説'
                          'text-bg-warning'
                        when 'ビジネス'
                          'text-bg-info'
                        when '自己啓発'
                          'text-bg-secondary'
                        else
                          'text-bg-secondary'
                        end
                      %>
                      <span class="badge <%= badge_class %> me-1"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>

              </div>
                <div class="col-md-4">
                  <div class='bg-light rounded p-3'>
                    <table class="table table-sm table-borderless mb-0">
                      <tbody><tr>
                        <th class="text-muted">登録日</th>
                        <td><%= @board.created_at.strftime("%Y-%m-%d") %></td>
                      </tr>
                      <tr>
                        <th class="text-muted">登録者</th>
                        <td><%= @board.user.name %></td>
                      </tr>
                      <tr>
                        <th class="text-muted">レビュー数</th>
                        <td><%= @board.reviews.size %>件</td>
                      </tr>
                    </tbody></table>
                    <hr>

                    <% if current_user.own?(@board) %>
                      <div class="d-grid gap-2">
                        <%= link_to edit_board_path(@board), class: "btn btn-outline-primary btn-sm" do %>
                          <i class='bi bi-pencil'></i> 編集
                        <% end %>
                        <%= link_to board_path(@board), id: "button-delete-#{@board.id}", class: "btn btn-outline-danger btn-sm", data: { turbo_method: :delete, turbo_confirm: '削除しますか？' } do %>
                          <i class="bi bi-trash-fill"></i> 削除
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>            
              </div>
        </div>
      </article>
    </div>
  </div>

  <div class="col-lg-12 mt-4">
      <div class="d-flex justify-content-between align-items-center mb-3">  
        <h4 class="mb-0">レビュー（<%= @board.reviews.size %>件）</h4>
        <%= link_to new_board_review_path(@board), class: "btn btn-success" do %>
          <i class="bi bi-pencil-square"></i> レビューを書く
        <% end %>
      </div>
    </div>

  <div class="row">
    <%= render @reviews %>
  </div>
</div>
