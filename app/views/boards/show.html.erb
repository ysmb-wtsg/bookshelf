<div class="container pt-5">
  <div class="row mb-3">
    <div class="col-lg-8 offset-lg-2">
      <h1><%= '書籍詳細' %></h1>
      <article class="card">
        <div class="card-body">
          <div class="row">
            <div class="col-md-12">
              <h3 style="display: inline;"><%= @board.title %></h3>
              <div class='d-flex justify-content-end'>
                <%= link_to edit_board_path(@board), id: "button-edit-#{@board.id}" do %>
                  <i class='bi bi-pencil-fill'></i> 編集
                <% end %>
                <%= link_to board_path(@board), id: "button-delete-#{@board.id}", data: { turbo_method: :delete, turbo_confirm: '削除しますか？' } do %>
                  <i class="bi bi-trash-fill"></i> 削除
                <% end %>
              </div>
              <ul class="list-inline mt-2">
                <li class="list-inline-item"><strong>著者:</strong> <%= @board.author %></li>
                <li class="list-inline-item"><i class="bi bi-calendar"></i> <%= l @board.created_at, format: :long %></li>
              </ul>
              <div class="text-muted small">
                登録者: <%= @board.user.name %>
              </div>
            </div>
          </div>
          <hr>
          <div class="mt-3">
            <h5>説明</h5>
            <p><%= simple_format(@board.body) %></p>
          </div>
        </div>
      </article>
    </div>
  </div>

  <%# コメントフォーム %>
  <div class="row">
    <div class="col-lg-8 offset-lg-2">
      <table class="table">
        <tbody id="table-comment">
          <%# コメント一覧 %>
        </tbody>
      </table>
    </div>
  </div>
</div>