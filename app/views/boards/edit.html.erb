<%# ↓なにもなかったら消す %>
<% content_for(:title, t('.title')) %>
<div class="container pt-5">
  <div class="row mb-3">
    <div class="col-lg-8 offset-lg-2">
      <h1><%= '書籍を編集' %></h1>
      
      <%= form_with model: @board do |f| %>
        <article class="card">
          <div class="card-body">
            <div class="row">
              <div class="col-md-12">
                <%# タイトル入力 %>
                <div class="mb-3">
                  <%= f.label :title %>
                  <%= f.text_field :title, class: "form-control" %>
                </div>
                
                <%# 著者入力 %>
                <div class="mb-3">
                  <%= f.label :author %>
                  <%= f.text_field :author, class: "form-control" %>
                </div>
                
                <ul class="list-inline mt-2">
                  <li class="list-inline-item"><i class="bi bi-calendar"></i> <%= l @board.created_at, format: :long %></li>
                </ul>
                <div class="text-muted small">
                  登録者: <%= @board.user.name %>
                </div>
              </div>
            </div>
            
            <hr>
            
            <%# 説明入力 %>
            <div class="mt-3">
              <div class="mb-3">
                <%= f.label :body, '説明' %>
                <%= f.text_area :body, class: "form-control", rows: "10" %>
              </div>
            </div>
            
            <%# 送信ボタン %>
            <div class="d-flex justify-content-between mt-4">
              <%= f.submit '更新する', class: "btn btn-primary" %>
              <%= link_to 'キャンセル', board_path(@board), class: "btn btn-secondary" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</div>