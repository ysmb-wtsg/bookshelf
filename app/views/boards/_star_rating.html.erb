<div class="star-rating">
  <% if board.reviews.present? %>
    <% rates =board.reviews.map(&:rate) %>
    <% average_rate = rates.sum.to_f / rates.size %>
    <% full_stars = average_rate.floor %>
    <% half_star = (average_rate - full_stars) >= 0.5 %>
    <% empty_stars = 5 - full_stars - (half_star ? 1 : 0) %>

    <!-- 塗りつぶされた星 -->
    <% full_stars.times do %>
      <i class="bi bi-star-fill text-warning"></i>
    <% end %>

    <!-- 半分の星 -->
    <% if half_star %>
      <i class="bi bi-star-half text-warning"></i>
    <% end %>

    <!-- 空の星 -->
    <% empty_stars.times do %>
      <i class="bi bi-star text-warning"></i>
    <% end %>

    <%# show_detail が true の場合のみ詳細情報を表示 %>
    <% if local_assigns[:show_detail] %>
      <span class="ms-2 text-muted"><%= average_rate.round(1) %> / 5.0 (<%= board.reviews.size %>件のレビュー)</span>
    <% end %>
  <% else %>
    <% if local_assigns[:show_detail] %>
      <span class="text-muted">まだレビューがありません</span>
    <% else %>
      <small class="text-muted">まだレビューがありません</small>
    <% end %>
  <% end %>
</div>