<div class="container mt-5">
  <div class="row justify-content-center">
    <div class=" col-md-5 col-lg-3">
      <div class="card">
         <div class="card-body"> 
           <h1 class="card-title text-center">ログイン</h1>
             <%= form_with url: login_path do |f| %>
               <div class="mb-3">
                 <%= f.label :メールアドレス %>
                 <%= f.email_field :email, class: "form-control", placeholder: "test@example.com" %>
               </div>
               <div class="mb-3">
                 <%= f.label :パスワード %>
                 <%= f.password_field :password, class: "form-control", placeholder: "パスワード" %>
               </div>
               <div class="form-check">
                 <input class="form-check-input" type="checkbox" value="" id="checkdefault" checked>
                 <label class="form-check-label" for="checkdefault">
                   ログイン状態を保持する
                 </label>
               </div>
               <div class="text-center">
                 <%= f.submit "ログイン", class: "btn btn-primary" %>
               </div>
             <% end %>
           <div class='text-center mt-1'>
             <%= link_to 'アカウントをお持ちでない方はこちら', new_user_path %>
           </div>
        </div>
      </div>
    </div>
  </div>
</div>