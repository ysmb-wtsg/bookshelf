<div class="container">
  <div class="row">
    <div class="col-lg-12 mt-4">
      <%= link_to '書籍一覧', boards_path, class:"link" %> / <%= link_to @board.title, board_path(@board), class:"link" %> / レビュー投稿
        <h2 class="my-3">レビューを投稿</h2>

        <div class="col-lg-12 border ">
          <h5 class="mt-3 mx-3"><%= @board.title %></h5>
          <div class="text-muted mx-3 mb-3">
            <i class="bi bi-person"></i> <%= @board.author %>
          </div>   
        </div>

        <div class="card mt-4">
          <%= form_with model: @review, url: board_reviews_path(@board) do |f| %>

            <!-- 星評価 -->
            <div class="m-3">
              <%= f.label :rate, '評価' %>
              <div class="d-flex gap-1 mt-2" id="star-rating">
                <% 1.upto(5) do |i| %>
                  <button type="button" class="btn btn-outline-warning star-btn" data-value="<%= i %>">
                    <i class="bi bi-star-fill"></i>
                  </button>
                <% end %>
              </div>
              <div class="form-text">1〜5の評価を選択してください</div>
              <%= f.hidden_field :rate, value: 0 %>
            </div>
                          
            <div class="m-3">
              <%= f.label :title, 'タイトル' %>
              <%= f.text_field :title, class: "form-control mt-2", placeholder: "例: 実践的で読みやすい" %>
            </div>
            <div class="m-3">
              <%= f.label :body, '本文' %>
              <%= f.text_area :body, class: "form-control mt-2", placeholder: "レビュー本文を入力してください...", rows: "6" %>
            </div>
            <hr>
            <div class="m-3">
              <%= f.submit '✓投稿する', class: "btn btn-success" %>
              <%= link_to 'キャンセル', boards_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>  
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    const starButtons = document.querySelectorAll('.star-btn');
    const rateInput = document.querySelector('#review_rate');
    
    if (!starButtons.length || !rateInput) return;
    
    // 星ボタンをクリックしたとき
    starButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault(); // フォーム送信を防ぐ
        
        const value = parseInt(this.dataset.value);
        rateInput.value = value;
        
        // すべての星ボタンから active クラスを削除
        starButtons.forEach(btn => btn.classList.remove('active'));
        
        // クリックした星以下のボタンに active クラスを追加
        starButtons.forEach(btn => {
          if (parseInt(btn.dataset.value) <= value) {
            btn.classList.add('active');
          }
        });
      });
    });
  });
</script>