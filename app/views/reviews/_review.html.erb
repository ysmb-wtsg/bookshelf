<div class="container my-2">
  <div id="review-<%= review.id %>">
    <div class="card">
      <div class="d-flex justify-content-between align-items-center m-3 mb-1">
        <div class="list-inline-item fw-bold"><i class="bi bi-person-circle"></i> 
          <%= review.user.name %>
          <small class="text-muted"><%= review.created_at.strftime("%Y-%m-%d") %></small>
        </div>
          <!-- 星の表示 -->
        <div class="star-rating">
          <% review.rate.times do %>
            <i class="bi bi-star-fill text-warning"></i>
          <% end %>
          <% (5 - review.rate).times do %>
            <i class="bi bi-star text-warning"></i>
          <% end %>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center my-2 me-3">
        <div class="mx-3 my-1 fw-bold"><%= review.title %></div>
         
        <% if current_user.own?(review) %>
          <div class="d-flex gap-2">
            <%= link_to edit_review_path(review), class: "btn btn-outline-primary btn-sm" do %>
              <i class='bi bi-pencil'></i> 編集
            <% end %>
            <%= link_to review_path(review), id: "button-delete-#{review.id}", class: "btn btn-outline-danger btn-sm", data: { turbo_method: :delete, turbo_confirm: '削除しますか？' } do %>
              <i class="bi bi-trash-fill"></i> 削除
            <% end %>
          </div>
        <% end %>
      </div>      

      <div class="mx-3 mb-3"><%= review.body %></div>
    </div>
  </div>
</div>