<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-3">
      <div class="card">
        <div class="card-body">
          <h1 class="card-title text-center">新規登録</h1>
        <%= form_with model: @user do |f| %>
          <div class="mb-3">
            <%= f.label :ユーザー名, class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "ユーザー名" %>
          </div>
          <div class="mb-3">
            <%= f.label :メールアドレス, class: "form-label" %>
            <%= f.email_field :email, class: "form-control", placeholder: "user@example.com" %>
          </div>
          <div class="mb-3">
            <%= f.label :パスワード, class: "form-label" %>
            <%= f.password_field :password, class: "form-control", placeholder: "6文字以上" %>
            <small>6文字以上で入力してください</small>
          </div>
          <div class="mb-3">
            <%= f.label :パスワード（確認）, class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control", placeholder: "パスワードを再入力" %>
          </div>
          <div class="d-grid">
            <%= f.submit "アカウント作成", class: "btn btn-primary" %>
          </div>
        <% end %>
        <div class='text-center mt-1'>
          <%= link_to 'すでにアカウントをお持ちの方はこちら', login_path, class: "link" %>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>